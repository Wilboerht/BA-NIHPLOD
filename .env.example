# ============================================================================
# NIHPLOD 品牌授权验证平台 (BAVP) — 环境变量配置模板
# ============================================================================
# 使用说明：
#   1. 复制此文件为 .env.local
#   2. 根据实际环境填写所有必需变量值
#   3. 不要将 .env.local 提交到 Git 仓库
# ============================================================================

# --- 数据库 ---
# PostgreSQL 连接字符串（必需）
# 格式：postgresql://用户名:密码@主机地址:端口/数据库名
# 不要追加 ?schema=public（Prisma 专用参数，postgres.js 运行时会连接失败）
DATABASE_URL="postgresql://user:password@localhost:5432/ba_nihplod_db"

# --- JWT 认证 ---
# JWT 签名密钥（必需），至少 32 位随机字符串
# 生成方式：openssl rand -base64 32
AUTH_SECRET="your-secret-key-at-least-32-chars"

# --- 应用基础 URL ---
# 用于邮件链接、二维码 URL 等（必需）
NEXT_PUBLIC_BASE_URL="https://ba.nihplod.cn"

# --- 时区（强烈建议显式配置） ---
# 应用侧日期判断使用该时区；数据库会话时区通过 DB_TIMEZONE 设置
TZ="Asia/Shanghai"
DB_TIMEZONE="Asia/Shanghai"
NEXT_PUBLIC_BUSINESS_TIME_ZONE="Asia/Shanghai"

# --- Google Analytics ---
# GA4 衡量 ID（可选，格式 G-XXXXXXXX）
NEXT_PUBLIC_GA_ID="G-EGYTDYWPP3"

# --- 邮件发送 (Resend) ---
# Resend API Key（可选，未配置时邮件功能降级为日志输出）
RESEND_API_KEY="re_xxxxxxxxxxxx"
# 发件人地址（可选，默认 noreply@nihplod.cn）
MAIL_FROM="noreply@nihplod.cn"

# --- 定时任务 ---
# 用于 /api/cron/update-expired-certificates 的安全密钥（必需，如需定时任务）
# 只接受请求头：x-cron-secret
CRON_SECRET="your-cron-secret"

# --- 私有证据 / 数据库超时 ---
# 匿名投诉证据全局容量上限（默认 2GB）
MAX_PRIVATE_UPLOAD_BYTES="2147483648"
# 已关闭/软删除工单证据保留天数（未设置时脚本默认 0 = 不清理）
UPLOAD_RETENTION_DAYS="180"
# 审计日志归档目录（archive:audit 使用）
# AUDIT_ARCHIVE_DIR="/var/backups/ba/audit-archives"
# 单条 SQL 超时（毫秒）
DB_STATEMENT_TIMEOUT_MS="15000"
# 可选：自定义上传目录
# PRIVATE_UPLOAD_ROOT="/var/www/BA-NIHPLOD/private/uploads"
# PUBLIC_UPLOAD_ROOT="/var/www/BA-NIHPLOD/public/uploads"

# --- SEO 站点验证 ---
# Google Search Console 验证码 (可选)
GOOGLE_SITE_VERIFICATION=""
# 百度站长平台验证码 (可选)
BAIDU_SITE_VERIFICATION=""

# --- 管理员初始化 ---
# 初始管理员密码（用于 scripts/initDefaultAdmins.mjs，可选）
ADMIN_INIT_PASSWORD="your-initial-admin-password"
# 默认管理员列表 JSON 数组（可选）
# 格式：'[{"username":"admin","fullName":"管理员","role":"SUPER_ADMIN"}]'
DEFAULT_ADMINS='[{"username":"admin","fullName":"管理员","role":"SUPER_ADMIN"}]'

# ===== 主站管理员 SSO（BA 作为 RP）=====
ADMIN_SSO_ENABLED="false"
ADMIN_SSO_AUTHORIZE_URL="https://nihplod.cn/admin/sso/authorize"
ADMIN_SSO_TOKEN_URL="http://127.0.0.1:3000/api/admin/sso/token"
ADMIN_SSO_STATUS_URL="http://127.0.0.1:3000/api/admin/sso/status"
ADMIN_SSO_CLIENT_ID="ba-admin"
ADMIN_SSO_CLIENT_SECRET="与主站 BA_ADMIN_SSO_CLIENT_SECRET 同值"
ADMIN_SSO_REDIRECT_URI="https://ba.nihplod.cn/api/admin/auth/sso/callback"
ADMIN_SSO_AUDIENCE="ba-admin"
# ADMIN_SSO_JWKS_URL="https://nihplod.cn/api/oauth/jwks"
# ADMIN_SSO_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
# 迁移期 all；最终 break-glass
ADMIN_SSO_LOCAL_LOGIN_MODE="break-glass"
ADMIN_SSO_EMAIL_FALLBACK="false"
ADMIN_SSO_SESSION_TTL_MINUTES="480"
# 旧 HS256 共享密钥仅迁移回退使用
# ADMIN_SSO_ALLOW_LEGACY_HS256="true"
# ADMIN_SSO_SECRET="..."
# SSO 开启时是否允许本地创建管理员；仅迁移/应急时临时设为 true
BA_ALLOW_LOCAL_ADMIN_CREATE="false"
BA_BREAK_GLASS_ENABLED="false"
BA_BREAK_GLASS_USERNAME="ba-emergency"
# 由 npm run init:break-glass 生成并写入；登录时始终强制校验 TOTP
BA_BREAK_GLASS_TOTP_SECRET=""
# 可选：仅供 init:break-glass 使用；未设置时脚本生成随机密码
# BA_BREAK_GLASS_PASSWORD=""

# ===== 主站内部 API（举报查看/处理 + 看板）=====
# secret 必须至少 32 字符，否则该条目会被静默忽略
INTERNAL_API_KEYS='[{"project":"ba","key":"generated-key","secret":"replace-with-at-least-32-random-characters"}]'
MAIN_SITE_INTERNAL_BASE="http://127.0.0.1:3000"
# 证书 internal 请求要求 x-internal-actor 签名；仅滚动升级窗口临时设为 true
# INTERNAL_API_ALLOW_UNSIGNED_ACTOR="false"
# 必须至少 32 字符的强随机串
BA_EVIDENCE_TOKEN_SECRET="replace-with-at-least-32-random-characters"

# 证书 PNG/PDF 私有存储目录（不要放 public/uploads）
# CERTIFICATE_ARTIFACT_ROOT="/var/www/BA-NIHPLOD/private/certificates"
