# ============================================================================
# NIHPLOD 品牌授权验证平台 (BAVP) — 环境变量配置模板
# ============================================================================
# 使用说明：
#   1. 复制此文件为 .env.local
#   2. 根据实际环境填写所有必需变量值
#   3. 不要将 .env.local 提交到 Git 仓库
# ============================================================================

# ----- 数据库（必需） -----
# PostgreSQL 连接字符串
# 格式: postgresql://用户名:密码@主机:端口/数据库名?schema=public
# 特殊字符需要 URL 编码，例如 ! 需要编码为 %21
DATABASE_URL="postgresql://your_db_user:your_password@localhost:5432/ba_nihplod_db?schema=public"

# ----- JWT 认证（必需） -----
# 至少 32 位随机字符串，用于签发和验证 Cookie Token
# 生成方式：openssl rand -base64 32
AUTH_SECRET="your-strong-random-secret-key-at-least-32-chars"

# ----- 站点基础域名（必需） -----
# 用于邮件链接、证书二维码生成绝对路径 URL，确保扫码可直接跳转验证页面
# 示例: https://ba.nihplod.cn 或 http://localhost:3000
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ----- 时区（强烈建议显式配置） -----
# 应用侧日期判断（证书有效期）使用该时区
TZ="Asia/Shanghai"
# 数据库会话时区（通过连接启动参数设置；缺省同样为 Asia/Shanghai）
DB_TIMEZONE="Asia/Shanghai"

# ----- 定时任务密钥（使用定时任务时必需） -----
# 用于保护 /api/cron/update-expired-certificates
# 建议 32 位以上随机字符串；两种调用方式均可：
#   curl -H "x-cron-secret: xxx" https://<域名>/api/cron/update-expired-certificates
#   curl "https://<域名>/api/cron/update-expired-certificates?secret=xxx"
CRON_SECRET="your-random-cron-secret-key"

# ----- 邮件发送 (Resend，可选) -----
# 未配置时邮件功能降级为日志输出
RESEND_API_KEY="re_xxxxxxxxxxxx"
MAIL_FROM="noreply@nihplod.cn"

# ----- 管理员初始化（可选） -----
# 初始管理员密码（用于 scripts/initDefaultAdmins.mjs，未设置则生成随机密码）
# ADMIN_INIT_PASSWORD="your-secure-admin-password"
# 默认管理员列表 JSON 数组
# 格式：'[{"username":"admin@example.com","fullName":"管理员","phone":"13800138000","email":"admin@example.com"}]'
# DEFAULT_ADMINS='[{"username":"admin@example.com","fullName":"管理员","role":"SUPER_ADMIN"}]'

# ----- SEO 站点验证（可选） -----
# GOOGLE_SITE_VERIFICATION=""
# BAIDU_SITE_VERIFICATION=""

# ----- Google Analytics（可选） -----
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# ============================================================================
# 反向代理要求（生产环境）
# ============================================================================
# 登录限流与投诉限流依赖客户端真实 IP：
#   1. Nginx 必须设置 X-Real-IP $remote_addr（应用优先读取该头）
#   2. 请勿将应用端口直接暴露公网，否则请求头可被伪造绕过限流
